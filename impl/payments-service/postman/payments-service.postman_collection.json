{
  "info": {
    "name": "payments-service",
    "description": "PTDRY payments-service (Express + TypeORM, port 4004, prefix /api/v1). Integrates Razorpay and Zohopay. User/tenant routes use Authorization: Bearer {{authToken}}; webhook routes are public and carry a provider signature header.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "ptdry-payments-service-0004-collection"
  },
  "item": [
    {
      "name": "payments",
      "item": [
        {
          "name": "01 Initiate Payment",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"created\", function(){ pm.response.to.have.status(201); });",
                  "var j = pm.response.json();",
                  "if (j && j.Data && j.Data.id) pm.environment.set(\"PAYMENT_ID\", j.Data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"OrderId\": \"{{ORDER_ID}}\",\n  \"OrderCode\": \"{{ORDER_CODE}}\",\n  \"AmountInr\": 499.00,\n  \"Provider\": \"Razorpay\",\n  \"Metadata\": {\n    \"channel\": \"customer-app\",\n    \"city\": \"Pune\"\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments/initiate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "payments", "initiate"]
            }
          }
        },
        {
          "name": "02 Mark Cash/UPI Payment",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"created\", function(){ pm.response.to.have.status(201); });",
                  "var j = pm.response.json();",
                  "if (j && j.Data && j.Data.id) pm.environment.set(\"PAYMENT_ID\", j.Data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"OrderId\": \"{{ORDER_ID}}\",\n  \"OrderCode\": \"{{ORDER_CODE}}\",\n  \"AmountInr\": 250.00,\n  \"Provider\": \"UPI\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments/cash",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "payments", "cash"]
            }
          }
        },
        {
          "name": "03 List Payments For Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"ok\", function(){ pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments/order/{{ORDER_ID}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "payments", "order", "{{ORDER_ID}}"]
            }
          }
        }
      ]
    },
    {
      "name": "webhooks",
      "item": [
        {
          "name": "01 Razorpay Webhook",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"received\", function(){ pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-razorpay-signature", "value": "{{razorpayWebhookSignature}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"payment.captured\",\n  \"account_id\": \"acc_Dev0000000001\",\n  \"entity\": \"event\",\n  \"contains\": [\"payment\"],\n  \"payload\": {\n    \"payment\": {\n      \"entity\": {\n        \"id\": \"pay_DevRzp0000001\",\n        \"entity\": \"payment\",\n        \"amount\": 49900,\n        \"currency\": \"INR\",\n        \"status\": \"captured\",\n        \"order_id\": \"order_DevRzp0000001\",\n        \"method\": \"upi\",\n        \"email\": \"rohan.sharma@example.in\",\n        \"contact\": \"+919812345678\"\n      }\n    }\n  },\n  \"created_at\": 1750000000\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/webhooks/razorpay",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "webhooks", "razorpay"]
            }
          }
        },
        {
          "name": "02 Zohopay Webhook",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"received\", function(){ pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-zohopay-signature", "value": "{{zohopayWebhookSignature}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_type\": \"payment.captured\",\n  \"payload\": {\n    \"payment\": {\n      \"entity\": {\n        \"id\": \"zpay_Dev0000001\",\n        \"order_id\": \"zorder_Dev0000001\",\n        \"amount\": 25000,\n        \"currency\": \"INR\",\n        \"status\": \"captured\",\n        \"email\": \"anita.desai@example.in\",\n        \"contact\": \"+919898989898\"\n      }\n    }\n  },\n  \"created_at\": 1750000000\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/webhooks/zohopay",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "webhooks", "zohopay"]
            }
          }
        }
      ]
    }
  ]
}
