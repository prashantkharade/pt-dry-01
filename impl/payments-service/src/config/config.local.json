{
    "SystemIdentifier"  : "PTKharade",
    "ServiceName"       : "payments-service",
    "BaseUrl"           : "http://localhost:4004",
    "Port"              : 4004,
    "ApiVersion"        : "v1",
    "Logger"            : { "Provider": "Custom", "Level": "Debug" },
    "Database"          : { "Type": "postgres", "ORM": "TypeORM" },
    "Cache"             : { "Provider": "Redis" },
    "Payments"          : { "Primary": "Razorpay", "Secondary": "Zohopay" },
    "MaxUploadFileSize" : 10485760,
    "Telemetry"         : false,
    "TemporaryFolders"  : {
        "UploadFolder"               : "./tmp/uploads/",
        "DownloadFolder"             : "./tmp/downloads/",
        "CleanupFolderBeforeMinutes" : 1440
    }
}
