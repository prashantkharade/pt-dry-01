# payments-service — :4004
NODE_ENV=local
PORT=4004
BASE_URL=http://localhost:4004

JWT_SECRET=replace-me-with-a-long-random-string

# === Database — options: sqlite | postgres | mysql =========================
DB_DIALECT=sqlite
PAYMENTS_DB_FILE=./data/payments.sqlite

# Postgres
# PAYMENTS_DB_URL=postgres://ptk:ptk@localhost:5432/payments_db
# MySQL
# PAYMENTS_DB_URL=mysql://ptk:ptk@localhost:3306/payments_db

DB_SYNC=true
LOG_SQL=false
LOG_LEVEL=info

# Razorpay (online payments).
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace-with-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-razorpay-webhook-secret

# Zohopay (online payments).
# OAuth: Zoho issues short-lived access tokens; we hold a long-lived refresh
# token and mint access tokens on demand.
ZOHOPAY_ACCOUNT_ID=replace-with-zoho-payments-account-id
ZOHOPAY_CLIENT_ID=replace-with-zoho-client-id
ZOHOPAY_CLIENT_SECRET=replace-with-zoho-client-secret
ZOHOPAY_REFRESH_TOKEN=replace-with-zoho-refresh-token
ZOHOPAY_ACCOUNTS_URL=https://accounts.zoho.in
# sandbox | live — selects paymentssandbox.zoho.in vs payments.zoho.in
ZOHOPAY_MODE=sandbox
# Required. Webhook verification fails closed without it: an unset secret
# rejects every webhook rather than accepting unsigned ones.
ZOHOPAY_WEBHOOK_SECRET=replace-with-zoho-webhook-signing-key

ORDERS_SERVICE_URL=http://localhost:4003/api/v1
NOTIFICATIONS_SERVICE_URL=http://localhost:4005/api/v1
# === Client-app / sister-service API keys ==================================
# Each var is the key BELONGING TO that client. A service needs the key of
# every caller it must accept, plus its own to identify itself outbound.
# Discovered by convention: API_KEY_<CLIENT_CODE> registers <CLIENT-CODE>.
API_KEY_ADMIN_PORTAL=admin-portal-dev-key
API_KEY_CUSTOMER_APP=customer-app-dev-key
API_KEY_IDENTITY_SERVICE=identity-service-dev-key
API_KEY_ORDERS_SERVICE=orders-service-dev-key
API_KEY_CATALOG_PRICING_SERVICE=catalog-pricing-service-dev-key
API_KEY_PAYMENTS_SERVICE=payments-service-dev-key
API_KEY_NOTIFICATIONS_SERVICE=notifications-service-dev-key
