meta {
  name: Mark Cash/UPI Payment
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/payments/cash
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "OrderId": "{{ORDER_ID}}",
    "OrderCode": "{{ORDER_CODE}}",
    "AmountInr": 250.00,
    "Provider": "UPI"
  }
}

vars:post-response {
  PAYMENT_ID: res.body.Data.id
}

tests {
  test("Mark Cash/UPI Payment works", function() {
    expect(res.getStatus()).to.equal(201);
  });
}
