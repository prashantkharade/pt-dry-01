# ===== Shared =====
NODE_ENV=development
JWT_SECRET=dev-secret-change-me-please
JWT_ACCESS_TTL_SEC=3600
JWT_REFRESH_TTL_SEC=2592000

# Inter-service api keys (paired with client_apps.ApiKeyHash)
API_KEY_ADMIN_PORTAL=admin-portal-dev-key
API_KEY_CUSTOMER_APP=customer-app-dev-key
API_KEY_ORDERS_SERVICE=orders-service-dev-key
API_KEY_IDENTITY_SERVICE=identity-service-dev-key

# Redis
REDIS_URL=redis://localhost:6379

# ===== identity-service =====
IDENTITY_PORT=4001
IDENTITY_DB_URL=postgres://ptk:ptk@localhost:5544/identity_db
IDENTITY_BASE_URL=http://localhost:4001

# ===== orders-service =====
ORDERS_PORT=4002
ORDERS_DB_URL=postgres://ptk:ptk@localhost:5544/orders_db
ORDERS_BASE_URL=http://localhost:4002
IDENTITY_SERVICE_URL=http://localhost:4001

# ===== Default seeded SystemAdmin =====
SEED_ADMIN_EMAIL=admin@ptkharade.in
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_PHONE=+919999900001
