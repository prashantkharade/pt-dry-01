# notifications-service — :4005
NODE_ENV=local
PORT=4005
BASE_URL=http://localhost:4005

JWT_SECRET=replace-me-with-a-long-random-string

# === Database — options: sqlite | postgres | mysql =========================
DB_DIALECT=sqlite
NOTIFICATIONS_DB_FILE=./data/notifications.sqlite

# Postgres
# NOTIFICATIONS_DB_URL=postgres://ptk:ptk@localhost:5432/notifications_db
# MySQL
# NOTIFICATIONS_DB_URL=mysql://ptk:ptk@localhost:3306/notifications_db

DB_SYNC=true
LOG_SQL=false
LOG_LEVEL=info

# Only required if you want BullMQ queue + worker.
# REDIS_URL=redis://localhost:6379

# SMS (MSG91 — common Indian provider).
MSG91_AUTH_KEY=replace-with-msg91-auth-key
MSG91_SENDER_ID=PTKHRD
MSG91_TEMPLATE_OTP=replace-with-msg91-otp-template-id

# Email (SMTP).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PT Kharade <noreply@ptkharade.in>

# WhatsApp (optional, behind a flag).
WHATSAPP_ENABLED=false

# Firebase Cloud Messaging for in-app push.
FCM_SERVER_KEY=replace-with-fcm-server-key

API_KEY_NOTIFICATIONS_SERVICE=notifications-service-dev-key
