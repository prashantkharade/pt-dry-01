# notifications-service — :4005
NODE_ENV=local
PORT=4005
BASE_URL=http://localhost:4005

JWT_SECRET=replace-me-with-a-long-random-string

# === Database — options: sqlite | postgres | mysql =========================
DB_DIALECT=sqlite
NOTIFICATIONS_DB_FILE=./data/notifications.sqlite

# Postgres
# NOTIFICATIONS_DB_URL=postgres://ptk:ptk@localhost:5432/notifications_db
# MySQL
# NOTIFICATIONS_DB_URL=mysql://ptk:ptk@localhost:3306/notifications_db

DB_SYNC=true
LOG_SQL=false
LOG_LEVEL=info

# Only required if you want BullMQ queue + worker.
# REDIS_URL=redis://localhost:6379

# SMS (MSG91 — common Indian provider).
MSG91_AUTH_KEY=replace-with-msg91-auth-key
MSG91_SENDER_ID=PTKHRD
MSG91_TEMPLATE_OTP=replace-with-msg91-otp-template-id

# Email (SMTP).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PT Kharade <noreply@ptkharade.in>

# WhatsApp (optional, behind a flag).
WHATSAPP_ENABLED=false

# Firebase Cloud Messaging for in-app push.
FCM_SERVER_KEY=replace-with-fcm-server-key
# === Client-app / sister-service API keys ==================================
# Each var is the key BELONGING TO that client. A service needs the key of
# every caller it must accept, plus its own to identify itself outbound.
# Discovered by convention: API_KEY_<CLIENT_CODE> registers <CLIENT-CODE>.
API_KEY_ADMIN_PORTAL=admin-portal-dev-key
API_KEY_CUSTOMER_APP=customer-app-dev-key
API_KEY_IDENTITY_SERVICE=identity-service-dev-key
API_KEY_ORDERS_SERVICE=orders-service-dev-key
API_KEY_CATALOG_PRICING_SERVICE=catalog-pricing-service-dev-key
API_KEY_PAYMENTS_SERVICE=payments-service-dev-key
API_KEY_NOTIFICATIONS_SERVICE=notifications-service-dev-key
# === Delivery queue (BullMQ) ==============================================
# Required in production. Without it, notifications are delivered inline with
# NO retry — a brief SMS-gateway blip silently loses an order confirmation.
REDIS_URL=redis://localhost:6379

# === Email (SMTP) =========================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PT Kharade <noreply@ptkharade.in>
# secure follows the port (465 => implicit TLS). Override only if you must.
# SMTP_SECURE=false
# Dev-only escape hatch for a self-signed relay. NEVER true in production:
# it disables TLS certificate validation and the connection becomes MITM-able.
# SMTP_ALLOW_INVALID_CERTS=false

# === SMS ==================================================================
# MSG91 | SMSCountry | Mock  (inferred from whichever keys are set if unset)
SMS_PROVIDER=Mock
MSG91_AUTH_KEY=
MSG91_SENDER=PTKHRD
MSG91_TEMPLATE_ID=
SMSCOUNTRY_AUTH_KEY=
SMSCOUNTRY_AUTH_TOKEN=
SMSCOUNTRY_SENDER_ID=PTKHRD

# === Push (FCM) ===========================================================
# Prefer the JSON inline: containers get secrets as env vars, and a path
# forces baking a key file into the image.
FCM_SERVICE_ACCOUNT_JSON=
# FCM_SERVICE_ACCOUNT_PATH=./config/fcm-service-account.json
