# orders-service — :4003
NODE_ENV=local
PORT=4003
BASE_URL=http://localhost:4003

JWT_SECRET=replace-me-with-a-long-random-string

# === Database — options: sqlite | postgres | mysql =========================
DB_DIALECT=sqlite

ORDERS_DB_FILE=./data/orders.sqlite

# Postgres
# ORDERS_DB_URL=postgres://ptk:ptk@localhost:5432/orders_db
# MySQL
# ORDERS_DB_URL=mysql://ptk:ptk@localhost:3306/orders_db

DB_SYNC=true
LOG_SQL=false
LOG_LEVEL=info

IDENTITY_SERVICE_URL=http://localhost:4001/api/v1
CATALOG_PRICING_SERVICE_URL=http://localhost:4002/api/v1
PAYMENTS_SERVICE_URL=http://localhost:4004/api/v1
NOTIFICATIONS_SERVICE_URL=http://localhost:4005/api/v1

API_KEY_ORDERS_SERVICE=orders-service-dev-key
