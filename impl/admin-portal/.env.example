IDENTITY_SERVICE_URL=http://localhost:4001/api/v1
CATALOG_PRICING_SERVICE_URL=http://localhost:4002/api/v1
ORDERS_SERVICE_URL=http://localhost:4003/api/v1
PAYMENTS_SERVICE_URL=http://localhost:4004/api/v1
NOTIFICATIONS_SERVICE_URL=http://localhost:4005/api/v1
API_KEY_ADMIN_PORTAL=admin-portal-dev-key
SESSION_COOKIE_NAME=ptk_session
SESSION_TTL_SEC=3600

# Session store. Required in production — the portal refuses to start
# without it rather than fall back to per-process in-memory sessions,
# which break under multiple instances and drop on every restart.
REDIS_URL=redis://localhost:6379

# === Web push (optional) ==================================================
# PUBLIC client config for FCM web push — safe to expose (not secrets).
# Leave blank to disable web push; the portal's SSE live feed still works.
# Also replace the __PLACEHOLDER__ values in static/firebase-messaging-sw.js.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=
PUBLIC_FIREBASE_VAPID_KEY=
