# identity-service — :4001
NODE_ENV=local
PORT=4001
BASE_URL=http://localhost:4001

# JWT — must be the same secret across every service.
JWT_SECRET=replace-me-with-a-long-random-string

# === Database ==============================================================
# DB_DIALECT chooses the driver. Options: sqlite | postgres | mysql
# - sqlite   → file-backed, zero infra (recommended for local dev)
# - postgres → install Postgres locally OR docker compose up postgres
# - mysql    → install MySQL locally OR docker run mysql
DB_DIALECT=sqlite

# SQLite (default)
IDENTITY_DB_FILE=./data/identity.sqlite

# Postgres
# IDENTITY_DB_URL=postgres://ptk:ptk@localhost:5432/identity_db
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USER=ptk
# DB_PASSWORD=ptk
# IDENTITY_DB_NAME=identity_db
# DB_SCHEMA=public

# MySQL
# IDENTITY_DB_URL=mysql://ptk:ptk@localhost:3306/identity_db
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=ptk
# DB_PASSWORD=ptk
# IDENTITY_DB_NAME=identity_db

DB_SYNC=true
LOG_SQL=false

# === Cache =================================================================
# REDIS_URL is optional. When unset, OTPs and sessions live in an in-process
# in-memory cache (fine for single-instance dev, NOT for multi-replica prod).
# REDIS_URL=redis://localhost:6379

LOG_LEVEL=info

# === Seed ==================================================================
SEED_ADMIN_EMAIL=admin@ptkharade.in
SEED_ADMIN_PHONE=+919999900001
SEED_ADMIN_PASSWORD=Admin@12345

# Inter-service API keys (seeded into client_apps on first boot).
# === Client-app / sister-service API keys ==================================
# Each var is the key BELONGING TO that client. A service needs the key of
# every caller it must accept, plus its own to identify itself outbound.
# Discovered by convention: API_KEY_<CLIENT_CODE> registers <CLIENT-CODE>.
API_KEY_ADMIN_PORTAL=admin-portal-dev-key
API_KEY_CUSTOMER_APP=customer-app-dev-key
API_KEY_IDENTITY_SERVICE=identity-service-dev-key
API_KEY_ORDERS_SERVICE=orders-service-dev-key
API_KEY_CATALOG_PRICING_SERVICE=catalog-pricing-service-dev-key
API_KEY_PAYMENTS_SERVICE=payments-service-dev-key
API_KEY_NOTIFICATIONS_SERVICE=notifications-service-dev-key
