{
  "info": {
    "name": "identity-service",
    "description": "PTDRY identity-service API collection. Base URL http://localhost:4001, prefix /api/v1. Login (or Verify OTP) first to capture authToken; most routes require Authorization: Bearer {{authToken}}. OTP/login routes are anonymous.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "b1e7c0a2-3d4f-4a8b-9c11-identity0001"
  },
  "item": [
    {
      "name": "auth",
      "item": [
        {
          "name": "01 Send OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"sent\", function(){ pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"Phone\": \"+919876543210\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/otp/send",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "otp", "send"]
            }
          }
        },
        {
          "name": "02 Verify OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"verified\", function(){ pm.response.to.have.status(200); });",
                  "var j = pm.response.json();",
                  "if (j && j.Data && j.Data.AccessToken) pm.environment.set(\"authToken\", j.Data.AccessToken);",
                  "if (j && j.Data && j.Data.User && j.Data.User.id) pm.environment.set(\"USER_ID\", j.Data.User.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"Phone\": \"+919876543210\",\n  \"Otp\": \"123456\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/otp/verify",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "otp", "verify"]
            }
          }
        },
        {
          "name": "03 Login (Password)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"logged in\", function(){ pm.response.to.have.status(200); });",
                  "var j = pm.response.json();",
                  "if (j && j.Data && j.Data.AccessToken) pm.environment.set(\"authToken\", j.Data.AccessToken);",
                  "if (j && j.Data && j.Data.User && j.Data.User.id) pm.environment.set(\"USER_ID\", j.Data.User.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"EmailOrPhone\": \"admin@ptkharade.in\",\n  \"Password\": \"Admin@12345\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        },
        {
          "name": "04 Logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"logged out\", function(){ pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "logout"]
            }
          }
        }
      ]
    },
