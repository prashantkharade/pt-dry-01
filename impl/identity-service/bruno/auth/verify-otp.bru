meta {
  name: Verify OTP
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/otp/verify
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "Phone": "+919876543210",
    "Otp": "123456"
  }
}

vars:post-response {
  authToken: res.body.Data.AccessToken
}

tests {
  test("Verify OTP works", function() {
    expect(res.getStatus()).to.equal(200);
  });
}
