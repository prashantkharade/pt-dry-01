# catalog-pricing-service — :4002
NODE_ENV=local
PORT=4002
BASE_URL=http://localhost:4002

# Same secret as identity-service so tokens issued there verify here.
JWT_SECRET=replace-me-with-a-long-random-string

# === Database ==============================================================
# Options: sqlite | postgres | mysql
DB_DIALECT=sqlite

# SQLite (default)
CATALOG_PRICING_DB_FILE=./data/catalog_pricing.sqlite

# Postgres
# CATALOG_PRICING_DB_URL=postgres://ptk:ptk@localhost:5432/catalog_pricing_db
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USER=ptk
# DB_PASSWORD=ptk
# CATALOG_PRICING_DB_NAME=catalog_pricing_db

# MySQL
# CATALOG_PRICING_DB_URL=mysql://ptk:ptk@localhost:3306/catalog_pricing_db
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=ptk
# DB_PASSWORD=ptk
# CATALOG_PRICING_DB_NAME=catalog_pricing_db

DB_SYNC=true
LOG_SQL=false

LOG_LEVEL=info

IDENTITY_SERVICE_URL=http://localhost:4001/api/v1
SEED_ADMIN_EMAIL=admin@ptkharade.in
SEED_ADMIN_PASSWORD=Admin@12345
# === Client-app / sister-service API keys ==================================
# Each var is the key BELONGING TO that client. A service needs the key of
# every caller it must accept, plus its own to identify itself outbound.
# Discovered by convention: API_KEY_<CLIENT_CODE> registers <CLIENT-CODE>.
API_KEY_ADMIN_PORTAL=admin-portal-dev-key
API_KEY_CUSTOMER_APP=customer-app-dev-key
API_KEY_IDENTITY_SERVICE=identity-service-dev-key
API_KEY_ORDERS_SERVICE=orders-service-dev-key
API_KEY_CATALOG_PRICING_SERVICE=catalog-pricing-service-dev-key
API_KEY_PAYMENTS_SERVICE=payments-service-dev-key
API_KEY_NOTIFICATIONS_SERVICE=notifications-service-dev-key
